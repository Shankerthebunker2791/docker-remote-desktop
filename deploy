#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# deploy — Tag and push the Xubuntu image to Docker Hub
#
# Required environment variables:
#   DOCKER_USERNAME   Docker Hub username
#   DOCKER_PASSWORD   Docker Hub password or access token
#   DOCKER_REPO       Target repository name (e.g. docker-remote-desktop)
#
# Optional:
#   TAG               Ubuntu codename (default: noble)
#   LOCAL_IMAGE       Local image name (default: xubuntu-dev:latest)
#
# Usage:
#   DOCKER_USERNAME=me DOCKER_PASSWORD=*** DOCKER_REPO=docker-remote-desktop ./deploy
# =============================================================================

TAG="${TAG:-noble}"
LOCAL_IMAGE="${LOCAL_IMAGE:-xubuntu-dev:latest}"

# Validate required variables.
missing=()
for var in DOCKER_USERNAME DOCKER_PASSWORD DOCKER_REPO; do
    if [ -z "${!var:-}" ]; then
        missing+=("${var}")
    fi
done
if [ "${#missing[@]}" -gt 0 ]; then
    echo "ERROR: missing required environment variable(s): ${missing[*]}" >&2
    echo "" >&2
    echo "Usage: DOCKER_USERNAME=x DOCKER_PASSWORD=x DOCKER_REPO=x ./deploy" >&2
    exit 1
fi

# Determine Ubuntu version from the base image.
docker pull "ubuntu:${TAG}"
OS_VERSION="$(docker run --rm "ubuntu:${TAG}" \
    /bin/bash -c "grep VERSION_ID= /etc/os-release | cut -d= -f2 | sed -E 's/\"//g'" | tr -d "\r")"

if [ -z "${OS_VERSION}" ]; then
    echo "ERROR: Unable to determine Ubuntu version" >&2
    exit 1
fi
echo "Found Ubuntu version '${OS_VERSION}'"

# Tag the locally built image.
docker tag "${LOCAL_IMAGE}" "${DOCKER_USERNAME}/${DOCKER_REPO}:ubuntu-${TAG}"
docker tag "${LOCAL_IMAGE}" "${DOCKER_USERNAME}/${DOCKER_REPO}:ubuntu-${OS_VERSION}"
docker tag "${LOCAL_IMAGE}" "${DOCKER_USERNAME}/${DOCKER_REPO}:latest"

# Login (password via stdin, never on the command line).
echo "${DOCKER_PASSWORD}" | docker login -u "${DOCKER_USERNAME}" --password-stdin

# Push.
docker push "${DOCKER_USERNAME}/${DOCKER_REPO}:ubuntu-${TAG}"
docker push "${DOCKER_USERNAME}/${DOCKER_REPO}:ubuntu-${OS_VERSION}"
docker push "${DOCKER_USERNAME}/${DOCKER_REPO}:latest"

# Always log out to avoid leaving credentials in ~/.docker/config.json.
docker logout

echo ""
echo "✓ Pushed ${DOCKER_USERNAME}/${DOCKER_REPO}:latest (ubuntu-${TAG}, ubuntu-${OS_VERSION})"
